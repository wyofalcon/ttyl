{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "TTYL: Start desktop tile",
      "type": "process",
      "command": "${workspaceFolder}/desktop-timer/.venv/Scripts/python.exe",
      "args": ["-m", "ttyl"],
      "options": {
        "cwd": "${workspaceFolder}/desktop-timer"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "close": false
      },
      "problemMatcher": []
    }
  ]
}
