                <mxCell id="lane-hdr-ln-gc" value="Cleanup / safety" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;shadow=1;fillColor=#CBA6F7;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1192" y="96" width="368" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="lane-body-ln-gc" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3EBFD;strokeColor=#CBA6F7;dashed=1;dashPattern=6 4;strokeWidth=1;opacity=40;" parent="1" vertex="1">
                    <mxGeometry x="1192" y="156" width="368" height="1216" as="geometry"/>
                </mxCell>
                <mxCell id="d-read" value="&lt;b&gt;Read stdin JSON&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#FFFFFF;strokeColor=#89B4FA;strokeWidth=1.5;fontColor=#333333;fontSize=11;fontStyle=1;" parent="1" tooltip="$(cat) — Claude Code pipes the hook payload over stdin." vertex="1">
                    <mxGeometry x="54" y="170" width="340" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="d-jq" value="&lt;b&gt;extract() via jq&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#FFFFFF;strokeColor=#89B4FA;strokeWidth=1.5;fontColor=#333333;fontSize=11;fontStyle=1;" parent="1" tooltip="extract() helper pulls session_id, cwd, hook_event_name from the JSON via jq." vertex="1">
                    <mxGeometry x="54" y="254" width="340" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="d-sed" value="&lt;b&gt;sed fallback (no jq)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#FFFFFF;strokeColor=#89B4FA;strokeWidth=1.5;fontColor=#333333;fontSize=11;fontStyle=1;" parent="1" tooltip="Falls back to sed-based extraction when jq isn&#39;t on PATH (default Git Bash on Windows lacks jq)." vertex="1">
                    <mxGeometry x="54" y="338" width="340" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="d-case" value="&lt;b&gt;case &amp;quot;$event&amp;quot; in …&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#FFFFFF;strokeColor=#FAB387;strokeWidth=1.5;fontColor=#333333;fontSize=11;fontStyle=1;" parent="1" tooltip="The case statement is the heart of the dispatcher." vertex="1">
                    <mxGeometry x="438" y="422" width="340" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="d-ssn" value="&lt;b&gt;SessionStart → state=none&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#FFFFFF;strokeColor=#FAB387;strokeWidth=1.5;fontColor=#333333;fontSize=11;fontStyle=1;" parent="1" tooltip="Fresh session, no request sent yet." vertex="1">
                    <mxGeometry x="438" y="506" width="340" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="d-act" value="&lt;b&gt;UserPromptSubmit | PreCompact → active&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#FFFFFF;strokeColor=#FAB387;strokeWidth=1.5;fontColor=#333333;fontSize=11;fontStyle=1;" parent="1" tooltip="Both regular prompts and /compact flip to active so the indicator never lies during compaction." vertex="1">
                    <mxGeometry x="438" y="590" width="340" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="d-idle" value="&lt;b&gt;Stop → state=idle:&amp;lt;epoch&amp;gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#FFFFFF;strokeColor=#FAB387;strokeWidth=1.5;fontColor=#333333;fontSize=11;fontStyle=1;" parent="1" tooltip="Records when the turn ended so the segment can compute remaining = TTL - (now - epoch)." vertex="1">
                    <mxGeometry x="438" y="674" width="340" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="d-end" value="&lt;b&gt;SessionEnd → rm + exit&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#FFFFFF;strokeColor=#FAB387;strokeWidth=1.5;fontColor=#333333;fontSize=11;fontStyle=1;" parent="1" tooltip="Drops the per-session JSON so the desktop tile promptly removes the row. Skips the rest of the script." vertex="1">
                    <mxGeometry x="438" y="758" width="340" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="d-other" value="&lt;b&gt;* → exit 0&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#FFFFFF;strokeColor=#FAB387;strokeWidth=1.5;fontColor=#333333;fontSize=11;fontStyle=1;" parent="1" tooltip="Defensive fall-through: if Claude Code adds a new event we don&#39;t know, we silently no-op." vertex="1">
                    <mxGeometry x="438" y="842" width="340" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="d-legacy" value="&lt;b&gt;Write legacy file&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#FFFFFF;strokeColor=#A6E3A1;strokeWidth=1.5;fontColor=#333333;fontSize=11;fontStyle=1;" parent="1" tooltip="printf &#39;%s&#39; &quot;$legacy_val&quot; &gt; ~/.claude/.cache-timestamp — back-compat for old status lines." vertex="1">
                    <mxGeometry x="822" y="926" width="340" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="d-empty" value="&lt;b&gt;[ -z &amp;quot;$session_id&amp;quot; ] &amp;amp;&amp;amp; exit 0&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#FFFFFF;strokeColor=#A6E3A1;strokeWidth=1.5;fontColor=#333333;fontSize=11;fontStyle=1;" parent="1" tooltip="Without a session_id we can&#39;t write the per-session file — the legacy mirror was enough." vertex="1">
                    <mxGeometry x="822" y="1010" width="340" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="d-preserve" value="&lt;b&gt;Preserve started_at&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#FFFFFF;strokeColor=#A6E3A1;strokeWidth=1.5;fontColor=#333333;fontSize=11;fontStyle=1;" parent="1" tooltip="If the per-session file already exists, jq-lookup the prior started_at and reuse it (so &#39;when did this chat begin&#39; stays stable across hook events)." vertex="1">
                    <mxGeometry x="822" y="1094" width="340" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="d-write" value="&lt;b&gt;Atomic .json.tmp → mv&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#FFFFFF;strokeColor=#A6E3A1;strokeWidth=1.5;fontColor=#333333;fontSize=11;fontStyle=1;" parent="1" tooltip="Build the JSON via printf, write to .tmp, then mv — so the watcher never sees a half-written file." vertex="1">
                    <mxGeometry x="822" y="1178" width="340" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="d-dedupe" value="&lt;b&gt;SessionStart cwd-dedupe&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#FFFFFF;strokeColor=#CBA6F7;strokeWidth=1.5;fontColor=#333333;fontSize=11;fontStyle=1;" parent="1" tooltip="When a fresh session starts in a folder another session was already in, delete the stale files. Prevents zombie rows in the tile after a restart." vertex="1">
                    <mxGeometry x="1206" y="1010" width="340" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="d-gc" value="&lt;b&gt;find -mmin +1440 -delete&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=1;fillColor=#FFFFFF;strokeColor=#CBA6F7;strokeWidth=1.5;fontColor=#333333;fontSize=11;fontStyle=1;" parent="1" tooltip="Best-effort GC: any per-session file untouched for &gt;24 h gets removed on the next hook fire." vertex="1">
